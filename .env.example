PORT=3001
DB_PATH=./data/sunflower.db
SYNC_API_KEY=your-secret-key-here

# Google Sheets
SHEET_ID=1rIlBUOG7T7rujdeQdAHrnBhwhD7gZ4Rh8C81xrVaVtY
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./sunflower-alert-21611001cc3c.json
# Thay cho dòng trên khi host không cho commit file key (Replit...): dán nguyên JSON vào một dòng
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Hoặc base64 nếu nơi host làm hỏng chuỗi dài khi dán:
# GOOGLE_SERVICE_ACCOUNT_B64=

# Đồng bộ
SYNC_INTERVAL_MINUTES=5
# Chỉ dùng để gieo giá trị lần chạy đầu. Sau đó ngưỡng sống trong DB và sửa
# bằng Settings panel; đổi biến này sẽ không còn tác dụng.
SLA_HOURS=4

# Mật khẩu mở Settings panel. Bỏ trống thì dùng mặc định evcsun@123.
# Chỉ có tác dụng lần chạy đầu; sau đó mật khẩu đã lưu thắng.
CONFIG_PASSWORD=
# Đặt =1 cùng CONFIG_PASSWORD mới rồi restart để ghi đè khi quên mật khẩu.
CONFIG_PASSWORD_RESET=

# Khoảng cách tối thiểu giữa hai lần bấm nút Refresh trên dashboard
REFRESH_COOLDOWN_SECONDS=20
